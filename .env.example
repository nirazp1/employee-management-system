# Database
DATABASE_NAME=ems_db
DATABASE_USERNAME=ems_user
DATABASE_PASSWORD=change-me
DATABASE_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/ems_db

# JWT (secret must be at least 256 bits / 32 characters)
JWT_SECRET=change-this-to-a-long-random-secret-value-at-least-32-chars
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=production

